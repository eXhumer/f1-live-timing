{
  "name": "@exhumer/f1-live-timing",
  "version": "2.2.0",
  "description": "F1 live timing client for Node.js: live SignalR Core feed, archive replay and a UTC timeline for syncing with video",
  "type": "module",
  "author": {
    "name": "eXhumer",
    "email": "github@exhumer.cc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eXhumer/f1-live-timing.git"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.19.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "onFail": "error"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "typecheck:package": "tsc -p tsconfig.package.json --noEmit",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage --reporter=junit --outputFile=test-report.junit.xml"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "f1",
    "formula1",
    "livetiming",
    "signalr",
    "telemetry",
    "typescript",
    "live-timing"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-istanbul": "^5.0.5",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@exhumer/signalr-client": "^3.0.0",
    "undici": "^8.12.2"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
